# Copy this file to .env.local for local development, and add the same values
# in Vercel/Netlify → Project → Settings → Environment Variables for production.
# Never commit .env.local. The secret values below must stay private.

# ── Supabase (Dashboard → Project Settings → API Keys) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable key" (sb_publishable_…) or the legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…) or the legacy "service_role" key. SERVER ONLY. Keep private.
SUPABASE_SECRET_KEY=

# ── Razorpay (Dashboard → Account & Settings → API Keys) ───────────
# Use rzp_test_… keys while testing, then switch both to rzp_live_… keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook (Settings → Webhooks).
RAZORPAY_WEBHOOK_SECRET=

# ── Delivery area ──────────────────────────────────────────────────
# Kitchen location: open Google Maps, long-press the kitchen, copy the two numbers.
NEXT_PUBLIC_KITCHEN_LAT=30.3616
NEXT_PUBLIC_KITCHEN_LNG=78.0854
# Only addresses within this many km (straight line) can order.
NEXT_PUBLIC_DELIVERY_RADIUS_KM=5
# Same-day orders allowed until this hour (IST, 24h). 10 = 10:00 AM.
NEXT_PUBLIC_ORDER_CUTOFF_HOUR=10

# ── Admins ─────────────────────────────────────────────────────────
# Comma-separated emails that get Kitchen admin access when they sign in.
ADMIN_EMAILS=
